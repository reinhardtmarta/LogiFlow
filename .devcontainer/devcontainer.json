{
  "name": "LogiFlow Node.js 22",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "LogiFlow development server",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm ci && sudo npm install --global firebase-tools",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
