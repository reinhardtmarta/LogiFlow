rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function onlyKeysChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['last_message', 'last_update', 'participants']);
    }

    match /profiles/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && !('plan' in request.resource.data)
        && !('product_limit' in request.resource.data)
        && !('subscription_status' in request.resource.data)
        && !('current_period_end' in request.resource.data)
        && !('product_count' in request.resource.data)
        && !('featured_product_id' in request.resource.data);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'phone', 'address', 'settings', 'updated_at',
                      'featured_product_id', 'product_count'])
        && (!('product_count' in request.resource.data)
            || request.resource.data.product_count is int);
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.seller_id == request.auth.uid
        && !('is_featured' in request.resource.data)
        && !('hidden' in request.resource.data);
      allow update: if isSignedIn()
        && resource.data.seller_id == request.auth.uid
        && request.resource.data.seller_id == request.auth.uid
        && !('is_featured' in request.resource.data)
        && !('hidden' in request.resource.data);
      allow delete: if isSignedIn()
        && resource.data.seller_id == request.auth.uid;
    }

    match /chats/{chatRoomId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && onlyKeysChanged();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.sender_id == request.auth.uid
          && request.resource.data.receiver_id != request.auth.uid
          && request.resource.data.created_at == request.time;
        allow update, delete: if false;
      }
    }

    match /pending_payments/{paymentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
